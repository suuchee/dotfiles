{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 9999,
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000"
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(diff:*)",
      "Bash(du:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(id:*)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(realpath:*)",
      "Bash(stat:*)",
      "Bash(tail:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(whoami:*)",
      "Bash(bq ls:*)",
      "Bash(bq show:*)",
      "Bash(chezmoi cat:*)",
      "Bash(chezmoi data:*)",
      "Bash(chezmoi diff:*)",
      "Bash(chezmoi doctor:*)",
      "Bash(chezmoi execute-template:*)",
      "Bash(chezmoi managed:*)",
      "Bash(chezmoi source-path:*)",
      "Bash(chezmoi status:*)",
      "Bash(gh api:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh label list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr view:*)",
      "Bash(gh release list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh variable list:*)",
      "Bash(gh workflow list:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git stash list:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)",
      "Bash(git tag:*)",
      "Bash(git commit:*)",
      "Bash(npm audit:*)",
      "Bash(npm explain:*)",
      "Bash(npm ls:*)",
      "Bash(npm outdated:*)",
      "Bash(npm run build:*)",
      "Bash(npm run format:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm view:*)",
      "Bash(pnpm audit:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm list:*)",
      "Bash(pnpm outdated:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm why:*)",
      "Bash(shellcheck:*)",
      "Bash(task --list:*)",
      "Bash(task build:*)",
      "Bash(task format:*)",
      "Bash(task lint:*)",
      "Bash(task test:*)",
      "Bash(task typecheck:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform show:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform version:*)",
      "Bash(uv --version:*)",
      "Bash(uv pip compile pyproject.toml -o requirements.txt:*)",
      "Bash(uv pip freeze:*)",
      "Bash(uv pip list:*)",
      "Bash(uv pip show:*)",
      "List(*)",
      "Search(*)",
      "WebFetch(domain:firebase.google.com)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:registry.terraform.io)",
      "WebFetch(domain:www.lineeye.co.jp)",
      "WebSearch(*)",
      "Skill(*)",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__server-sequential-thinking__sequentialthinking",
      "mcp__server-time__get_current_time",
      "mcp__plugin_freee-api_freee__freee_api_get",
      "mcp__plugin_freee-api_freee__freee_api_list_paths",
      "mcp__plugin_freee-api_freee__freee_auth_status",
      "mcp__plugin_freee-api_freee__freee_current_user",
      "mcp__plugin_freee-api_freee__freee_get_current_company",
      "mcp__plugin_freee-api_freee__freee_list_companies",
      "mcp__pencil"
    ],
    "deny": [
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(rm -r:*)",
      "Bash(rm -rf:*)",
      "Bash(shred:*)",
      "Bash(git add -A:*)",
      "Bash(git checkout .:*)",
      "Bash(git clean -f:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git restore .:*)",
      "Bash(git rm -rf:*)",
      "Bash(chmod 777:*)",
      "Bash(killall:*)",
      "Bash(pkill:*)",
      "Bash(reboot:*)",
      "Bash(shutdown:*)",
      "Bash(su:*)",
      "Bash(sudo:*)",
      "Bash(nc:*)",
      "Bash(netcat:*)",
      "Bash(scp:*)",
      "Bash(crontab -r:*)",
      "Bash(eval:*)",
      "Bash(history:*)",
      "mcp__plugin_freee-api_freee__freee_api_post",
      "mcp__plugin_freee-api_freee__freee_api_put",
      "mcp__plugin_freee-api_freee__freee_api_patch",
      "mcp__plugin_freee-api_freee__freee_api_delete"
    ],
    "ask": [
      "Bash(kill:*)",
      "Bash(git push --force-with-lease:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/safe-rm.sh",
            "timeout": 5,
            "statusMessage": "Checking for safe delete..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "skill-creator@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "language": "Japanese",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": [
        ".worktrees/",
        "~/.Trash",
        "/tmp"
      ]
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
